# Copie para .env.local e ajuste os valores.

# URL do backend usada pelo BFF (src/pages/api). Somente servidor: nunca é
# enviada ao navegador. Obrigatória em produção; em desenvolvimento, se vazia,
# o BFF usa http://localhost:3333/.
API_URL=http://localhost:3333/

# Papel atribuído às contas criadas em /register. Definido apenas no servidor;
# qualquer role enviada pelo navegador é ignorada. Padrão: admin.
SIGNUP_DEFAULT_ROLE=admin

# Notificações em tempo real (socket.io). Só conecta com ENABLED=true e uma URL
# http(s):// ou ws(s):// válida. Veja a seção "Realtime" do README.
NEXT_PUBLIC_REALTIME_ENABLED=false
NEXT_PUBLIC_REALTIME_URL=

# Modo release: o BFF responde com dados fictícios e o login aceita qualquer
# credencial. Só liga com o valor exato "release". NUNCA use em produção.
# NEXT_PUBLIC_APP_ENV=release
